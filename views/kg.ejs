<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>IIS Kindergarten</title>
    <link rel="stylesheet" href="CSS/main.css" />
    <link rel="stylesheet" href="CSS/kg.css" />
  </head>
  <body>
    <!-- Header -->
    <header class="header">
      <div class="container header-inner">
        <div class="logo">
          <img src="assets/images/logo.png" alt="IIS Logo" />
        </div>
        <nav class="nav">
          <ul class="nav-menu">
            <li><a href="/" class="nav-link active">Home</a></li>
            <li><a href="/about" class="nav-link">About</a></li>
            <li><a href="news" class="nav-link">News</a></li>
            <li><a href="/gallery" class="nav-link">Gallery</a></li>
            <li><a href="/contact" class="nav-link">Contact</a></li>
            <li><a href="/register" class="nav-link">Register</a></li>
          </ul>
        </nav>
      </div>
    </header>

    <!-- Hero Section -->
    <section class="kg-banner">
      <div class="container banner-inner">
        <h1 class="banner-title">Kindergarten</h1>
        <p class="banner-subtitle">
          Where little minds bloom with joy and curiosity
        </p>
      </div>
    </section>

    <!-- Main Content -->
    <main class="main">
      <div class="container">
        <!-- Welcome Section -->
        <section class="section welcome">
          <h2>Welcome to IIS Kindergarten</h2>
          <p>
            Our Kindergarten is a nurturing, colorful, and safe space designed
            to spark creativity, develop social skills, and build a strong
            foundation for lifelong learning. We believe in learning through
            play, exploration, and love.
          </p>
        </section>

        <!-- Photo Gallery -->
        <section class="section gallery">
          <h2>Our Happy Moments</h2>
          <div class="gallery-grid">
            <img src="assets/images/kg-1.jpg" alt="KG kids playing" />
            <img src="assets/images/kg-2.jpg" alt="Art & Craft" />
            <img src="assets/images/kg-3.jpg" alt="Outdoor fun" />
            <img src="assets/images/kg-4.jpg" alt="Story time" />
          </div>
          <div class="btn-wrapper">
            <a href="#" class="btn">See Full Gallery</a>
          </div>
        </section>

        <!-- Features -->
        <section class="section features">
          <h2>Why Choose IIS KG?</h2>
          <div class="features-grid">
            <div class="feature-card">
              <h3>Play-Based Learning</h3>
              <p>Hands-on activities that make learning fun and natural.</p>
            </div>
            <div class="feature-card">
              <h3>Experienced Teachers</h3>
              <p>Loving, trained educators who care for every child.</p>
            </div>
            <div class="feature-card">
              <h3>Safe & Colorful Campus</h3>
              <p>Bright classrooms and secure play areas.</p>
            </div>
            <div class="feature-card">
              <h3>Holistic Development</h3>
              <p>Focus on emotional, social, and cognitive growth.</p>
            </div>
          </div>
        </section>
      </div>
    </main>

    <!-- Footer -->
    <footer class="footer">
      <div class="container">
        <p>&copy; 2025 IIS. All rights reserved.</p>
      </div>
    </footer>
  </body>
</html>
