<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>
      IIS - Indian International School | Center of Intellectual Pursuits
    </title>
    <link
      href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@500;700&family=Inter:wght@400;600&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/CSS/style.css" />
    <link rel="stylesheet" href="/CSS/main.css" />
  </head>
  <body>
    <!-- Header/Navigation -->

    <!-- Hero Section -->
    <section class="hero">
      <header class="header">
        <nav class="navbar">
          <div class="nav-brand">
            <img src="/Images/logo.png" alt="IIS Logo" class="logo-img" />
          </div>
          <ul class="nav-menu">
            <li><a href="#" class="nav-link">Home</a></li>
            <li><a href="#" class="nav-link">About</a></li>
            <li><a href="#" class="nav-link">News</a></li>
            <li><a href="#" class="nav-link">Gallery</a></li>
            <li><a href="#" class="nav-link">Contact</a></li>
            <li><a href="#" class="nav-link active">Register</a></li>
          </ul>
        </nav>
      </header>

      <div class="hero-banner">
        <div class="banner-overlay">
          <h1 class="hero-title">Center of Intellectual Pursuits.</h1>
          <div class="hero-stats">
            <div class="stat">
              <span class="stat-number">900+</span>
              <span class="stat-label">Enrollments</span>
            </div>
            <div class="stat">
              <span class="stat-number">20+</span>
              <span class="stat-label">Qualified Staff</span>
            </div>
            <div class="stat">
              <span class="stat-number">5+</span>
              <span class="stat-label">Clubs</span>
            </div>
            <div class="stat">
              <span class="stat-number">15</span>
              <span class="stat-label">Years of Expertise</span>
            </div>
          </div>
          <div class="hero-buttons">
            <a href="#" class="btn btn-primary">Register</a>
            <a href="#" class="btn btn-secondary">Learn more</a>
          </div>
        </div>
      </div>
    </section>

    <section class="welcome">
      <div class="container">
        <h2 class="section-title">Welcome!!</h2>
      </div>
    </section>

    <section class="about">
      <div class="container">
        <div class="about-content">
          <p>
            Indian International School, established in 2006 in Addis Ababa,
            provides quality education from KG to Grade 8, and is expanding to
            higher secondary. Known for academic excellence and a 100% national
            exam pass rate, IIS nurtures students of all nationalities in a
            supportive, high-standard learning environment.
          </p>
        </div>
      </div>
    </section>

    <section class="branches">
      <div class="container">
        <h2 class="section-title">Our Branches</h2>
        <div class="branches-grid">
          <div class="branch-card">
            <img src="/Images/KG.png" alt="Branch 2" />
            <div class="branch-info">
              <h3>KG</h3>
              <a href="#" class="btn btn-secondary">Learn more</a>
            </div>
          </div>
          <div class="branch-card">
            <img src="/Images/primary.png" alt="Branch 3" />
            <div class="branch-info">
              <h3>Primary</h3>
              <a href="#" class="btn btn-secondary">Learn more</a>
            </div>
          </div>

          <div class="branch-card">
            <img src="/Images/secondary.png" alt="Branch 4" />
            <div class="branch-info">
              <h3>Secondary</h3>
              <a href="#" class="btn btn-secondary">Learn more</a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="highlights">
      <div class="container">
        <h2 class="section-title">Highlights</h2>
        <div class="highlights-grid">
          <div class="highlight-card">
            <img src="/Images/activities.png" alt="Activities" />
            <h3>Activities</h3>
            <p>Our students discover their passions.</p>
          </div>
          <div class="highlight-card">
            <img src="/Images/community.png" alt="Community" />
            <h3>Community</h3>
            <p>A place where you are known, valued, and connected.</p>
          </div>
          <div class="highlight-card">
            <img src="/Images/innovation.png" alt="Innovation" />
            <h3>Innovation</h3>
            <p>We prepare students for tomorrow.</p>
          </div>

          <div class="highlight-card">
            <img src="/Images/celebration.png" alt="Celebrations" />
            <h3>Celebrations</h3>
            <p>Annual Day and cultural events.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="faq">
      <div class="container">
        <h2 class="section-title">FAQ</h2>
        <div class="faq-list">
          <div class="faq-item">
            <button class="faq-question">
              What are the school's admission requirements?
              <span class="faq-toggle">+</span>
            </button>
            <div class="faq-answer">
              <p>
                Admission is open to all nationalities. Requirements include
                birth certificate, previous school records, and an entrance
                assessment for Grades 1+.
              </p>
            </div>
          </div>
          <div class="faq-item">
            <button class="faq-question">
              How do I apply or enroll my child?
              <span class="faq-toggle">+</span>
            </button>
            <div class="faq-answer">
              <p>
                Visit our registration page, fill out the form, and submit
                documents. Our admissions team will contact you within 48 hours.
              </p>
            </div>
          </div>
          <div class="faq-item">
            <button class="faq-question">
              What curriculum does the school follow?
              <span class="faq-toggle">+</span>
            </button>
            <div class="faq-answer">
              <p>
                We follow the Indian CBSE curriculum with international
                standards, emphasizing holistic development.
              </p>
            </div>
          </div>
          <div class="faq-item">
            <button class="faq-question">
              What are the school hours? <span class="faq-toggle">+</span>
            </button>
            <div class="faq-answer">
              <p>
                KG: 8:00 AM - 12:00 PM; Grades 1-8: 8:00 AM - 3:00 PM, Monday to
                Friday.
              </p>
            </div>
          </div>
        </div>
        <div class="faq-more">
          <a href="#" class="btn btn-secondary">See more</a>
        </div>
      </div>
    </section>

    <footer class="footer">
      <div class="container">
        <div class="footer-content">
          <img src="/Images/logo.png" alt="IIS Logo" class="footer-logo" />
          <div class="footer-signup">
            <input
              type="email"
              placeholder="Enter your email"
              class="email-input"
            />
            <button class="btn btn-primary">Register</button>
          </div>
        </div>
        <p class="footer-copy">&copy; 2025 IIS. All Rights Reserved.</p>
      </div>
    </footer>

    <script>
      document.querySelectorAll(".faq-question").forEach((btn) => {
        btn.addEventListener("click", () => {
          const answer = btn.nextElementSibling;
          const toggle = btn.querySelector(".faq-toggle");
          answer.style.display =
            answer.style.display === "block" ? "none" : "block";
          toggle.textContent = answer.style.display === "block" ? "−" : "+";
        });
      });
    </script>
  </body>
</html>
